---
const WA_NUMBER = '529514401726';
const WA_MSG    = encodeURIComponent('Hola, me interesa conocer sus servicios de desarrollo de software.');

const info = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.7A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16z"/></svg>`,
    label: 'Teléfono',
    value: '+52 (951) 440-1726',
    href: 'tel:+529514401726',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
    label: 'WhatsApp',
    value: '+52 (951) 440-1726',
    href: `https://wa.me/${WA_NUMBER}?text=${WA_MSG}`,
    external: true,
    highlight: true,
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    label: 'Email',
    value: 'ordazruudvan@gmail.com',
    href: 'mailto:ordazruudvan@gmail.com',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
    label: 'Ubicación',
    value: 'Oaxaca, México',
    href: '#',
  },
];
---

<section class="section" id="contacto">
  <div class="container contact-grid">

    <!-- LEFT INFO -->
    <div class="contact-left">
      <p class="section-tag reveal-left">// CONTACTO</p>
      <h2 class="section-title reveal-left" style="transition-delay:.1s">
        Platiquemos<br/>sobre tu proyecto<span class="c-dot">.</span>
      </h2>
      <p class="section-sub reveal-left" style="transition-delay:.2s">
        Cuéntanos tu reto. En 24 horas te enviamos una propuesta
        inicial sin costo y sin compromisos.
      </p>

      <ul class="info-list reveal-left" style="transition-delay:.3s" role="list">
        {info.map(i => (
          <li>
            <a
              href={i.href}
              class={`info-item${i.highlight ? ' info-item--wa' : ''}`}
              target={i.external ? '_blank' : undefined}
              rel={i.external ? 'noopener noreferrer' : undefined}
            >
              <div class={`info-icon${i.highlight ? ' info-icon--wa' : ''}`} aria-hidden="true" set:html={i.icon} />
              <div>
                <span class="info-label">{i.label}</span>
                <span class="info-val">{i.value}</span>
              </div>
              {i.highlight && <span class="wa-badge">Escríbenos</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- RIGHT FORM -->
    <div class="contact-right reveal-right">
      <form class="contact-form" id="contactForm" novalidate>
        <div class="form-row">
          <div class="form-group">
            <label for="name">Nombre completo</label>
            <input id="name" name="name" type="text" placeholder="Fulanito de Tal" required />
          </div>
          <div class="form-group">
            <label for="email">Correo electrónico</label>
            <input id="email" name="email" type="email" placeholder="fulanito@empresa.com" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="empresa">Empresa</label>
            <input id="empresa" name="empresa" type="text" placeholder="Mi Empresa S.A." />
          </div>
          <div class="form-group">
            <label for="telefono">Número de teléfono</label>
            <input id="telefono" name="telefono" type="tel" placeholder="+52 (000) 000-0000" />
          </div>
        </div>
        <div class="form-group full">
          <label for="mensaje">Cuéntanos tu proyecto</label>
          <textarea id="mensaje" name="mensaje" rows="5" placeholder="Describe brevemente qué quieres construir o qué problema necesitas resolver..." required></textarea>
        </div>

        <button type="submit" class="btn btn-primary form-btn">
          Enviar mensaje
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>
        </button>

        <p class="form-note">Respondemos en menos de 24 horas hábiles.</p>
        <div class="form-success" id="formSuccess" role="alert" aria-live="polite"></div>
      </form>
    </div>
  </div>
</section>

<style>
.c-dot { color: var(--cyan); }

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 5rem;
  align-items: start;
}

/* INFO */
.info-list {
  margin-top: 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  list-style: none;
}
.info-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  text-decoration: none;
  transition: transform 0.2s;
}
.info-item:hover { transform: translateX(4px); }
.info-icon {
  width: 42px; height: 42px;
  border: 1px solid var(--card-b);
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cyan);
  flex-shrink: 0;
  transition: border-color 0.2s, background 0.2s;
}
.info-item:hover .info-icon {
  border-color: var(--cyan);
  background: var(--cyan-dim);
}

/* WhatsApp item */
.info-item--wa { position: relative; }
.info-icon--wa {
  color: #25D366;
  border-color: rgba(37,211,102,0.3);
}
.info-item--wa:hover .info-icon--wa {
  border-color: #25D366;
  background: rgba(37,211,102,0.1);
}
.wa-badge {
  margin-left: auto;
  font-size: 0.65rem;
  font-family: var(--font-tech);
  letter-spacing: 0.08em;
  color: #25D366;
  border: 1px solid rgba(37,211,102,0.35);
  background: rgba(37,211,102,0.08);
  padding: 0.2rem 0.6rem;
  border-radius: 99px;
  white-space: nowrap;
}
.info-label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  color: var(--gray2);
  margin-bottom: 0.15rem;
}
.info-val {
  font-size: 0.9rem;
  color: var(--white);
  font-weight: 500;
}

/* FORM */
.contact-form {
  background: var(--card-bg);
  border: 1px solid var(--card-b);
  border-radius: var(--radius);
  padding: 2.5rem;
  backdrop-filter: blur(10px);
}
.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1rem;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.form-group.full { margin-bottom: 1.25rem; }

label {
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  color: var(--gray);
  font-family: var(--font-tech);
}
input, select, textarea {
  background: rgba(0,212,255,0.03);
  border: 1px solid var(--card-b);
  border-radius: 6px;
  padding: 0.75rem 1rem;
  color: var(--white);
  font-family: var(--font-body);
  font-size: 0.875rem;
  transition: border-color 0.2s, background 0.2s;
  outline: none;
  width: 100%;
}
input::placeholder, textarea::placeholder { color: var(--gray2); }
input:focus, select:focus, textarea:focus {
  border-color: var(--cyan);
  background: rgba(0,212,255,0.05);
  box-shadow: 0 0 0 3px rgba(0,212,255,0.08);
}
select { appearance: none; cursor: pointer; }
select option { background: #041123; color: var(--white); }
textarea { resize: vertical; min-height: 130px; }

.form-btn { width: 100%; justify-content: center; margin-top: 0.25rem; }
.form-note {
  text-align: center;
  font-size: 0.72rem;
  color: var(--gray2);
  margin-top: 0.75rem;
  letter-spacing: 0.04em;
}
.form-success {
  margin-top: 1rem;
  font-size: 0.85rem;
  color: var(--cyan);
  text-align: center;
  min-height: 1.2em;
}

@media (max-width: 900px) {
  .contact-grid { grid-template-columns: 1fr; gap: 3rem; }
  .form-row { grid-template-columns: 1fr; }
}
@media (max-width: 480px) {
  .contact-form { padding: 1.5rem; }
}
</style>

<script>
document.getElementById('contactForm')!.addEventListener('submit', (e) => {
  e.preventDefault();
  const form = e.target as HTMLFormElement;
  const msg  = document.getElementById('formSuccess')!;
  const btn  = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  btn.disabled = true;
  btn.textContent = 'Enviando...';

  // Simulate send — replace with your actual fetch/API call
  setTimeout(() => {
    msg.textContent = '✓ Mensaje enviado. Te contactaremos en menos de 24 h.';
    form.reset();
    btn.disabled = false;
    btn.innerHTML = 'Enviar mensaje <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/></svg>';
  }, 1200);
});
</script>