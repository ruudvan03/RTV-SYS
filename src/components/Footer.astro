---
const year = new Date().getFullYear();
const links = [
  { label: 'Servicios',  href: '#servicios'  },
  { label: 'Nosotros',   href: '#nosotros'   },
  { label: 'Tecnología', href: '#tech'       },
  { label: 'Proceso',    href: '#proceso'    },
  { label: 'Contacto',   href: '#contacto'   },
];
---

<footer class="footer">
  <div class="footer-glow" aria-hidden="true"></div>
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="RTV SYS inicio">
          <span class="lb">[</span>RTV<span class="ld">·</span>SYS<span class="lb">]</span>
        </a>
        <p class="footer-tagline">Desarrollo de software y sistemas<br/>que mueven empresas.</p>
      </div>

      <nav class="footer-nav" aria-label="Navegación pie de página">
        <p class="footer-nav-title">Navegación</p>
        <ul role="list">
          {links.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-contact">
        <p class="footer-nav-title">Contacto</p>
        <ul role="list">
          <li><a href="tel:+529514401726">+52 (951) 440-1726</a></li>
          <li><a href="mailto:ordazruudvan@gmail.com">ordazruudvan@gmail.com</a></li>
          <li>Oaxaca, México</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copy">&copy; {year} RTV SYS. Todos los derechos reservados.</p>
      <div class="footer-socials" aria-label="Redes sociales">
        <a href="#" aria-label="LinkedIn" class="social">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/></svg>
        </a>
        <a href="#" aria-label="GitHub" class="social">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/></svg>
        </a>
        <a href="#" aria-label="WhatsApp" class="social">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  position: relative;
  z-index: 1;
  border-top: 1px solid var(--card-b);
  padding: 5rem 1.5rem 2.5rem;
  overflow: hidden;
}
.footer-glow {
  position: absolute;
  bottom: -60px; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 200px;
  background: radial-gradient(ellipse, rgba(0,212,255,0.08), transparent 70%);
  pointer-events: none;
}

.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 3rem;
  margin-bottom: 3rem;
}

.footer-logo {
  font-family: var(--font-tech);
  font-size: 1.3rem;
  font-weight: 900;
  color: var(--white);
  display: inline-block;
  margin-bottom: 0.9rem;
  transition: color 0.2s;
}
.footer-logo:hover { color: var(--cyan); }
.lb { color: var(--cyan); }
.ld { color: var(--cyan); font-size: 1.5rem; vertical-align: -2px; }

.footer-tagline {
  color: var(--gray);
  font-size: 0.88rem;
  line-height: 1.7;
}

.footer-nav-title {
  font-family: var(--font-tech);
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  color: var(--cyan);
  margin-bottom: 1.1rem;
}
.footer-nav ul, .footer-contact ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}
.footer-nav a, .footer-contact a, .footer-contact li {
  color: var(--gray);
  font-size: 0.87rem;
  transition: color 0.2s;
}
.footer-nav a:hover, .footer-contact a:hover { color: var(--white); }

/* BOTTOM */
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 2rem;
  border-top: 1px solid var(--card-b);
}
.copy { font-size: 0.78rem; color: var(--gray2); }

.footer-socials { display: flex; gap: 0.75rem; }
.social {
  width: 36px; height: 36px;
  border: 1px solid var(--card-b);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray);
  transition: color 0.2s, border-color 0.2s, background 0.2s;
}
.social:hover {
  color: var(--cyan);
  border-color: rgba(0,212,255,0.4);
  background: var(--cyan-dim);
}

@media (max-width: 700px) {
  .footer-top { grid-template-columns: 1fr; gap: 2rem; }
  .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
}
</style>
