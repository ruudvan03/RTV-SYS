---
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9l2 2 4-4M9 15l2 2 4-4"/></svg>`,
    title: 'Software a Medida',
    desc: 'Construimos sistemas completamente personalizados a tu proceso. Desde ERPs hasta plataformas web complejas.',
    tags: ['Node.js', 'Laravel', 'React'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>`,
    title: 'Bases de Datos',
    desc: 'Diseño, optimización y migración de bases de datos. Consultas rápidas aunque manejes millones de registros.',
    tags: ['PostgreSQL', 'MySQL', 'MongoDB'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>`,
    title: 'Business Intelligence',
    desc: 'Transforma datos en decisiones. Dashboards en tiempo real, reportes automatizados y KPIs que importan.',
    tags: ['Power BI', 'Python'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Automatización',
    desc: 'Elimina tareas repetitivas con robots de proceso, integraciones entre sistemas y flujos automáticos.',
    tags: ['APIs'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>`,
    title: 'Aplicaciones Web',
    desc: 'Sitios y aplicaciones web rápidas, modernas y escalables. SEO, rendimiento y experiencia de usuario premium.',
    tags: ['Astro', 'Next.js', 'Vue'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Consultoría Tech',
    desc: 'Auditamos tu stack, identificamos cuellos de botella y trazamos una hoja de ruta tecnológica clara y ejecutable.',
    tags: ['Arquitectura', 'DevOps', 'Seguridad'],
  },
];
---

<section class="section" id="servicios">
  <div class="container">
    <div class="services-header reveal">
      <p class="section-tag">// SERVICIOS</p>
      <h2 class="section-title">Lo que construimos<br/><em>para ti</em></h2>
      <p class="section-sub">
        Soluciones tecnológicas de alto impacto, diseñadas desde cero
        para adaptarse a tu modelo de negocio.
      </p>
    </div>

    <div class="services-grid" role="list">
      {services.map((s, i) => (
        <article class="card reveal" style={`transition-delay:${i * 0.08}s`} role="listitem">
          <div class="card-glow" aria-hidden="true"></div>
          <div class="card-icon" aria-hidden="true" set:html={s.icon} />
          <h3 class="card-title">{s.title}</h3>
          <p class="card-desc">{s.desc}</p>
          <div class="card-tags" aria-label="Tecnologías">
            {s.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.services-header { margin-bottom: 4rem; }
.section-title em {
  font-style: normal;
  color: var(--cyan);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.25rem;
}

.card {
  position: relative;
  background: var(--card-bg);
  border: 1px solid var(--card-b);
  border-radius: var(--radius);
  padding: 2rem;
  overflow: hidden;
  cursor: default;
  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease,
    opacity 0.7s ease;
}

.card-glow {
  position: absolute;
  top: -60px; left: -60px;
  width: 180px; height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,255,0.12), transparent 70%);
  opacity: 0;
  transition: opacity 0.4s;
  pointer-events: none;
}

.card:hover {
  border-color: rgba(0,212,255,0.45);
  background: rgba(0,212,255,0.06);
  transform: translateY(-5px);
}
.card:hover .card-glow { opacity: 1; }

.card-icon {
  width: 44px; height: 44px;
  color: var(--cyan);
  margin-bottom: 1.25rem;
  transition: transform 0.3s;
}
.card:hover .card-icon { transform: scale(1.1); }

.card-title {
  font-family: var(--font-tech);
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 0.65rem;
  letter-spacing: 0.02em;
}

.card-desc {
  font-size: 0.875rem;
  color: var(--gray);
  line-height: 1.75;
  margin-bottom: 1.25rem;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.tag {
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  color: var(--cyan);
  border: 1px solid rgba(0,212,255,0.25);
  background: rgba(0,212,255,0.06);
  padding: 0.25rem 0.6rem;
  border-radius: 4px;
  font-family: var(--font-tech);
}
</style>
