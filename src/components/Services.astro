---
const services = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9l2 2 4-4M9 15l2 2 4-4"/></svg>`,
    title: 'Desarrollo de Software',
    desc: 'Construimos sistemas completamente personalizados a tu proceso y negocio. ERPs, plataformas web, sistemas de gestión y más.',
    tags: ['A medida', 'Escalable', 'Soporte'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>`,
    title: 'Páginas Web a la Medida',
    desc: 'Diseño y desarrollo de sitios web profesionales, rápidos y optimizados. Tu presencia digital que genera clientes.',
    tags: ['Diseño', 'SEO', 'Responsive'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: 'Mantenimiento Preventivo',
    desc: 'Revisiones periódicas de tus equipos de cómputo para evitar fallas. Limpieza, diagnóstico y optimización de rendimiento.',
    tags: ['Equipos', 'Diagnóstico', 'Periódico'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>`,
    title: 'Mantenimiento Correctivo',
    desc: 'Reparación y diagnóstico rápido de equipos de cómputo con fallas. Recuperamos tu equipo y tu productividad.',
    tags: ['Reparación', 'Rápido', 'Garantía'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>`,
    title: 'Instalación de Office',
    desc: 'Instalación y configuración de Microsoft Office en Windows y Mac. Word, Excel, PowerPoint y todas las aplicaciones que necesitas.',
    tags: ['Windows', 'Mac', 'Configuración'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05M12 22.08V12"/></svg>`,
    title: 'Licencias Permanentes',
    desc: 'Instalación de programas con licencias permanentes y originales. Software legal, sin suscripciones mensuales.',
    tags: ['Original', 'Permanente', 'Legal'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>`,
    title: 'Instalación de Cámaras',
    desc: 'Instalación y configuración de sistemas de videovigilancia para tu negocio o hogar. Monitoreo remoto incluido.',
    tags: ['Seguridad', 'CCTV', 'Remoto'],
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>`,
    title: 'Automatización de Procesos',
    desc: 'Elimina tareas repetitivas con integraciones entre sistemas y flujos automáticos que ahorran tiempo y dinero.',
    tags: ['Eficiencia', 'Integración', 'Ahorro'],
  },
];
---

<section class="section" id="servicios">
  <div class="container">
    <div class="services-header reveal">
      <p class="section-tag">// SERVICIOS</p>
      <h2 class="section-title">Todo lo que<br/><em>necesitas</em></h2>
      <p class="section-sub">
        Soluciones tecnológicas completas para tu empresa u negocio,
        desde Oaxaca para todo México.
      </p>
    </div>

    <div class="services-grid" role="list">
      {services.map((s, i) => (
        <article class="card reveal" style={`transition-delay:${i * 0.08}s`} role="listitem">
          <div class="card-glow" aria-hidden="true"></div>
          <div class="card-icon" aria-hidden="true" set:html={s.icon} />
          <h3 class="card-title">{s.title}</h3>
          <p class="card-desc">{s.desc}</p>
          <div class="card-tags" aria-label="Tecnologías">
            {s.tags.map(t => <span class="tag">{t}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.services-header { margin-bottom: 4rem; }
.section-title em {
  font-style: normal;
  color: var(--cyan);
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.25rem;
}

.card {
  position: relative;
  background: var(--card-bg);
  border: 1px solid var(--card-b);
  border-radius: var(--radius);
  padding: 2rem;
  overflow: hidden;
  cursor: default;
  transition:
    transform 0.35s ease,
    border-color 0.35s ease,
    background 0.35s ease,
    opacity 0.7s ease;
}

.card-glow {
  position: absolute;
  top: -60px; left: -60px;
  width: 180px; height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,255,0.12), transparent 70%);
  opacity: 0;
  transition: opacity 0.4s;
  pointer-events: none;
}

.card:hover {
  border-color: rgba(0,212,255,0.45);
  background: rgba(0,212,255,0.06);
  transform: translateY(-5px);
}
.card:hover .card-glow { opacity: 1; }

.card-icon {
  width: 44px; height: 44px;
  color: var(--cyan);
  margin-bottom: 1.25rem;
  transition: transform 0.3s;
}
.card:hover .card-icon { transform: scale(1.1); }

.card-title {
  font-family: var(--font-tech);
  font-size: 0.95rem;
  font-weight: 700;
  margin-bottom: 0.65rem;
  letter-spacing: 0.02em;
}

.card-desc {
  font-size: 0.875rem;
  color: var(--gray);
  line-height: 1.75;
  margin-bottom: 1.25rem;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.tag {
  font-size: 0.65rem;
  letter-spacing: 0.1em;
  color: var(--cyan);
  border: 1px solid rgba(0,212,255,0.25);
  background: rgba(0,212,255,0.06);
  padding: 0.25rem 0.6rem;
  border-radius: 4px;
  font-family: var(--font-tech);
}
</style>